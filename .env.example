# ============================================================================
# .env.example —— 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，勿提交）
# 仅用于阿里云 ECS 直接部署（start_oss.sh 会 source 本文件）。
# Docker 部署则把同样的值配到 ECS 控制台的「环境变量」或 docker run -e。
# ============================================================================

# ---- 看板访问口令（前端登录用，未配默认 lucie2026，生产务必改） ----
ACCESS_PASSWORD=lucie2026

# ---- 存储后端：固定 oss（阿里云） ----
STORAGE_MODE=oss

# ---- 阿里云 OSS（RAM 子账号，最小权限：仅本 bucket 读写；切勿用主账号 AK） ----
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=<替换为 RAM 子账号 AccessKeyId>
OSS_ACCESS_KEY_SECRET=<替换为 RAM 子账号 AccessKeySecret>
OSS_BUCKET=<替换为 bucket 名，如 sku-spu-data>
# OSS_PREFIX=sku-spu/   # 可选：多环境隔离用的统一前缀

# ---- 应用端口（gunicorn 监听，nginx 反代到它） ----
PORT=8092
